<Window x:Class="LibraryManagementSystem.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management System - Registration" Height="300" Width="400"
        Background="#F0FFF0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Registration" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="20" Foreground="DarkGreen"/>

        <StackPanel Grid.Row="1" Margin="10">
            <Label Content="Username:" Foreground="DarkGreen"/>
            <TextBox x:Name="UsernameTextBox" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10">
            <Label Content="Password:" Foreground="DarkGreen"/>
            <PasswordBox x:Name="PasswordBox" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="RegisterButton" Content="Register" Padding="10,5" Margin="5" Click="RegisterButton_Click" Background="ForestGreen" Foreground="White" BorderBrush="DarkGreen"/>
            <Button x:Name="CancelButton" Content="Cancel" Padding="10,5" Margin="5" Click="CancelButton_Click" Background="LightGreen" Foreground="DarkGreen" BorderBrush="DarkGreen"/>
        </StackPanel>
    </Grid>
</Window>